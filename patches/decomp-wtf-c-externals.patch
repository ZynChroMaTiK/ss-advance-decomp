+def _externals(obj: str) -> tuple[set[str], set[str]]:
+    """Unresolved references and Thumb branch targets from compiled C.
+
+    Such references can be absent from the catalogue and luvdis assembly.
+    Branch mode comes from relocation types, not the symbol's name.
+    """
+    from elftools.elf.elffile import ELFFile
+
+    with open(ROOT / obj, "rb") as f:
+        elf = ELFFile(f)
+        symtab = elf.get_section_by_name(".symtab")
+        wanted = {s.name for s in symtab.iter_symbols()
+                  if s.name and s["st_shndx"] == "SHN_UNDEF"} if symtab else set()
+        thumb = set()
+        for section in elf.iter_sections():
+            if section["sh_type"] not in ("SHT_REL", "SHT_RELA"):
+                continue
+            symbols = elf.get_section(section["sh_link"])
+            for relocation in section.iter_relocations():
+                # R_ARM_THM_CALL (old name THM_PC22), R_ARM_THM_JUMP24.
+                if relocation["r_info_type"] in (10, 30):
+                    thumb.add(symbols.get_symbol(relocation["r_info_sym"]).name)
+        return wanted, thumb
 
 
